<Window x:Class="RadialFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialFlow.UI.Markup"
        Title="{loc:Loc Settings.WindowTitle}"
        Width="1040" Height="680"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor, antes do InitializeComponent). -->
    <Window.Resources>
        <loc:LocFormatConverter x:Key="LocFormat"/>
        <!-- Ícones vetoriais da navegação lateral (traço de 1,6 px, pontas arredondadas). -->
        <GeometryGroup x:Key="IconGeneral">
            <LineGeometry StartPoint="4,7" EndPoint="6.8,7"/>
            <LineGeometry StartPoint="11.2,7" EndPoint="20,7"/>
            <LineGeometry StartPoint="4,17" EndPoint="12.8,17"/>
            <LineGeometry StartPoint="17.2,17" EndPoint="20,17"/>
            <EllipseGeometry Center="9,7" RadiusX="2.2" RadiusY="2.2"/>
            <EllipseGeometry Center="15,17" RadiusX="2.2" RadiusY="2.2"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconAppearance">
            <PathGeometry Figures="M12,3 C7.6,3 4,6.6 4,11 C4,14.7 6.5,17.6 9.9,18 C10.9,18.1 11.4,18.9 11.1,19.7 C10.7,20.9 11.7,22 13,22 C17.6,22 21,18.2 21,13 C21,7.5 17,3 12,3 Z"/>
            <EllipseGeometry Center="7.8,10.2" RadiusX="1.1" RadiusY="1.1"/>
            <EllipseGeometry Center="10.4,6.8" RadiusX="1.1" RadiusY="1.1"/>
            <EllipseGeometry Center="14.4,6.6" RadiusX="1.1" RadiusY="1.1"/>
            <EllipseGeometry Center="17.4,9.8" RadiusX="1.1" RadiusY="1.1"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconBlacklist">
            <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
            <LineGeometry StartPoint="6.2,17.8" EndPoint="17.8,6.2"/>
        </GeometryGroup>
        <PathGeometry x:Key="IconFavorites"
                      Figures="M12,3.4 L14.6,9.2 L21,9.9 L16.2,14.1 L17.6,20.4 L12,17.1 L6.4,20.4 L7.8,14.1 L3,9.9 L9.4,9.2 Z"/>
        <GeometryGroup x:Key="IconMenus">
            <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
            <EllipseGeometry Center="12,12" RadiusX="3.2" RadiusY="3.2"/>
            <LineGeometry StartPoint="12,3.5" EndPoint="12,8.8"/>
            <LineGeometry StartPoint="20.5,12" EndPoint="15.2,12"/>
            <LineGeometry StartPoint="12,20.5" EndPoint="12,15.2"/>
            <LineGeometry StartPoint="3.5,12" EndPoint="8.8,12"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconConverters">
            <PathGeometry Figures="M4.5,12 A7.5,7.5 0 0 1 19.5,12"/>
            <PathGeometry Figures="M19.5,12 A7.5,7.5 0 0 1 4.5,12"/>
            <PathGeometry Figures="M17.2,9.7 L19.5,12 L17.2,14.3"/>
            <PathGeometry Figures="M6.8,9.7 L4.5,12 L6.8,14.3"/>
        </GeometryGroup>
        <GeometryGroup x:Key="IconAbout">
            <EllipseGeometry Center="12,12" RadiusX="8.5" RadiusY="8.5"/>
            <LineGeometry StartPoint="12,11" EndPoint="12,17"/>
            <EllipseGeometry Center="12,7.4" RadiusX="0.7" RadiusY="0.7"/>
        </GeometryGroup>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="3,10,0,7"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>
        <Style x:Key="ValueBadge" TargetType="Border" BasedOn="{StaticResource ValuePill}">
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style x:Key="EndpointText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
        </Style>

        <!-- Navegação lateral: o cabeçalho de cada página fica no conteúdo da aba. -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="42" Margin="0,1">
                            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="10"/>
                            <Border x:Name="gloss" Height="1" Margin="10,1,10,0" VerticalAlignment="Top"
                                    Background="{DynamicResource GlossBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="13,0,10,0" VerticalAlignment="Center">
                                <Path Data="{TemplateBinding Tag}" Width="18" Height="18" Margin="0,0,9,0"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" Stretch="Uniform" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}"/>
                                <Setter TargetName="gloss" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="marker" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentOnSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="216"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,22,18">
                                        <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource AccentSoftBrush}"
                                                     Stroke="{DynamicResource AccentLineBrush}" StrokeThickness="1"/>
                                            <Ellipse Width="15" Height="15" Stroke="{DynamicResource AccentTextBrush}"
                                                     StrokeThickness="2.5"/>
                                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource AccentTextBrush}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="RadialFlow" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{loc:Loc Settings.SidebarTitle}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardBorderBrush}"
                                            Margin="16,0,16,6"/>

                                    <TextBlock DockPanel.Dock="Bottom" Text="{loc:Loc Settings.SidebarFooter}" FontSize="10.5"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="22,12,22,16"
                                               TextWrapping="Wrap"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel IsItemsHost="True" Margin="10,2,10,4"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Style="{StaticResource SettingsTabControl}">

            <!-- ================= GERAL ================= -->
            <TabItem Header="{loc:Loc Settings.General}" Tag="{StaticResource IconGeneral}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="{loc:Loc Settings.General}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Settings.GeneralSubtitle}" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <!-- O ScrollViewer fica na linha "*" da página: recebe altura finita e rola. -->
                    <ScrollViewer x:Name="GeneralScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="32,4,20,20">

                            <ContentControl Content="{loc:Loc Settings.General.StartupSection}" Style="{StaticResource SectionHeader}" Margin="3,0,0,7"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{loc:Loc Settings.General.StartWithWindows}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Settings.General.StartWithWindowsHint}"
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Margin="0"
                                                  VerticalAlignment="Center" Checked="DirtyState_Changed"
                                                  Unchecked="DirtyState_Changed"
                                                  AutomationProperties.Name="{loc:Loc Settings.General.StartWithWindows}"/>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{loc:Loc Settings.General.BlockFullscreen}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Settings.General.BlockFullscreenHint}"
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkBlockFullscreen" Grid.Column="1" Margin="0"
                                                  VerticalAlignment="Center" Checked="DirtyState_Changed"
                                                  Unchecked="DirtyState_Changed"
                                                  AutomationProperties.Name="{loc:Loc Settings.General.BlockFullscreen}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{loc:Loc Settings.General.GestureSection}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{loc:Loc Settings.General.Sensitivity}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Settings.General.SensitivityHint}"
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBadge}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource ValueText}"
                                                       Text="{Binding ElementName=SliderDeadzone, Path=Value, StringFormat='{}{0:0} px'}"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderDeadzone" Minimum="8" Maximum="40" SmallChange="1" LargeChange="5"
                                            AutomationProperties.Name="{loc:Loc Settings.General.SensitivityAutomation}"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0"
                                            ValueChanged="DirtyState_Changed"/>
                                    <Grid Margin="1,0,1,0">
                                        <TextBlock Text="8 px" Style="{StaticResource EndpointText}"/>
                                        <TextBlock Text="40 px" Style="{StaticResource EndpointText}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{loc:Loc Settings.General.Dwell}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Settings.General.DwellHint}"
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBadge}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource ValueText}"
                                                       Text="{Binding ElementName=SliderDwell, Path=Value, StringFormat='{}{0:0} ms'}"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderDwell" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="250"
                                            AutomationProperties.Name="{loc:Loc Settings.General.DwellAutomation}"
                                            IsSnapToTickEnabled="True" TickFrequency="50" Margin="0,12,0,0"
                                            ValueChanged="DirtyState_Changed"/>
                                    <Grid Margin="1,0,1,0">
                                        <TextBlock Text="200 ms" Style="{StaticResource EndpointText}"/>
                                        <TextBlock Text="2000 ms" Style="{StaticResource EndpointText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{loc:Loc Settings.General.HotkeySection}" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{loc:Loc Settings.General.Hotkey}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Settings.General.HotkeyHint}"
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBadge}" VerticalAlignment="Top">
                                            <TextBlock x:Name="HotkeyDisplay" Style="{StaticResource ValueText}"
                                                       Text="{loc:Loc Settings.General.HotkeyNone}"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="BtnRecordHotkey" Content="{loc:Loc Settings.General.HotkeyRecord}"
                                                Click="BtnRecordHotkey_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="{loc:Loc Settings.General.HotkeyRecord}"/>
                                        <Button x:Name="BtnClearHotkey" Content="{loc:Loc Settings.General.HotkeyClear}"
                                                Click="BtnClearHotkey_Click"
                                                AutomationProperties.Name="{loc:Loc Settings.General.HotkeyClear}"/>
                                    </StackPanel>

                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CardHint}"
                                               Margin="0,8,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= APARÊNCIA ================= -->
            <TabItem Header="{loc:Loc Settings.Appearance}" Tag="{StaticResource IconAppearance}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="{loc:Loc Settings.Appearance}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Settings.AppearanceSubtitle}" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer x:Name="AppearanceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="32,4,20,20">

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.Appearance.Accent}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}"
                                               Text="{loc:Loc Settings.Appearance.AccentHint}"/>
                                    <StackPanel x:Name="AccentChips" Orientation="Horizontal" Margin="0,14,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                        <TextBlock Text="{loc:Loc Settings.Appearance.Selected}" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AccentName" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.Appearance.WheelStyle}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}"
                                               Text="{loc:Loc Settings.Appearance.WheelStyleHint}"/>
                                    <ComboBox x:Name="CmbWheelPreset" Width="280" HorizontalAlignment="Left" Margin="0,10,0,0"
                                              DisplayMemberPath="Label" SelectionChanged="WheelPreset_Changed"
                                              AutomationProperties.Name="{loc:Loc Settings.Appearance.WheelStyle}"/>
                                    <TextBlock x:Name="WheelPresetHint" Style="{StaticResource FieldHint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Settings.Language}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{loc:Loc Settings.LanguageDescription}"
                                               Style="{StaticResource CardHint}"/>
                                    <ComboBox x:Name="CmbLanguage" Width="280" HorizontalAlignment="Left" Margin="0,10,0,0"
                                              DisplayMemberPath="NativeName" SelectionChanged="Language_Changed"
                                              AutomationProperties.Name="{loc:Loc Settings.Language}"/>
                                    <TextBlock Text="{loc:Loc Settings.LanguageHint}" Style="{StaticResource FieldHint}"/>
                                    <TextBlock x:Name="LanguageRestartHint" Text="{loc:Loc Settings.RestartRequired}"
                                               Style="{StaticResource FieldHint}" Foreground="{DynamicResource WarningBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= BLACKLIST ================= -->
            <TabItem Header="{loc:Loc Settings.Blacklist}" Tag="{StaticResource IconBlacklist}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="{loc:Loc Settings.Blacklist.Title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Settings.Blacklist.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,4,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BlacklistCount" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnResetBlacklist" Content="{loc:Loc Common.ResetDefaults}" Click="BtnResetBlacklist_Click"/>
                                <Button x:Name="BtnRemoveBlacklist" Content="{loc:Loc Common.Remove}" IsEnabled="False" Margin="8,0,0,0"
                                        Click="BtnRemoveBlacklist_Click"/>
                                <Button x:Name="BtnAddBlacklist" Content="{loc:Loc Settings.Blacklist.Add}" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="BtnAddBlacklist_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ListBlacklist" Background="{DynamicResource CardBrush}" Padding="6"
                                     AutomationProperties.Name="{loc:Loc Settings.Blacklist.Title}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="18,0,0,0"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="PnlNoBlacklist" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="16" Visibility="Collapsed">
                                <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72E;"/>
                                </Border>
                                <TextBlock Text="{loc:Loc Settings.Blacklist.EmptyTitle}" FontSize="13.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:Loc Settings.Blacklist.EmptyHint}"
                                           Style="{StaticResource CardHint}" TextAlignment="Center"
                                           MaxWidth="300" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= APPS FAVORITOS ================= -->
            <TabItem Header="{loc:Loc Settings.Favorites}" Tag="{StaticResource IconFavorites}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="{loc:Loc Settings.Favorites.PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Settings.Favorites.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,4,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FavoritesCount" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnResetFavorites" Content="{loc:Loc Common.ResetDefaults}" Click="BtnResetFavorites_Click"/>
                                <Button x:Name="BtnRemoveFavorite" Content="{loc:Loc Common.Remove}" IsEnabled="False" Margin="8,0,0,0"
                                        Click="BtnRemoveFavorite_Click"/>
                                <Button x:Name="BtnAddFavorite" Content="{loc:Loc Settings.Favorites.Add}" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="BtnAddFavorite_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ListFavorites" Background="{DynamicResource CardBrush}" Padding="6"
                                     AutomationProperties.Name="{loc:Loc Settings.Favorites.PageTitle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                                    Background="{DynamicResource ControlBrush}" VerticalAlignment="Center">
                                                <TextBlock x:Name="favoriteGlyph" Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" Margin="16,0,12,0"
                                                       Foreground="{DynamicResource TextDimBrush}" ToolTip="{Binding ExecutablePath}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Arguments}" MaxWidth="150"
                                                       Foreground="{DynamicResource TextDimBrush}" ToolTip="{Binding Arguments}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Glyph}" Value="">
                                                <Setter TargetName="favoriteGlyph" Property="Text" Value="&#xE734;"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                                <Setter TargetName="favoriteGlyph" Property="Text" Value="&#xE734;"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="PnlNoFavorites" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="16" Visibility="Collapsed">
                                <Border Style="{StaticResource IconBadge}" HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE734;"/>
                                </Border>
                                <TextBlock Text="{loc:Loc Settings.Favorites.EmptyTitle}" FontSize="13.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{loc:Loc Settings.Favorites.EmptyHint}"
                                           Style="{StaticResource CardHint}" TextAlignment="Center"
                                           MaxWidth="300" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= MENUS PERSONALIZADOS (editor em código: SettingsWindow.Menus.cs) ================= -->
            <TabItem Header="{loc:Loc Settings.Menus}" Tag="{StaticResource IconMenus}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="{loc:Loc Menus.PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Menus.PageSubtitle}"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid x:Name="MenusWorkspace" Grid.Row="1" Margin="32,4,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,14,14,12" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Loc Menus.ProfilesTitle}" Style="{StaticResource CardTitle}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                                Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MenuProfileCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       AutomationProperties.Name="{loc:Loc Menus.ProfilesCountAutomation}"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Menus.ProfilesHint}" Style="{StaticResource CardHint}"
                                               FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button x:Name="BtnNewMenuProfile" Content="{loc:Loc Menus.NewMenu}" Style="{StaticResource PrimaryButton}"
                                            Click="BtnAddMenuProfile_Click" Margin="0,0,0,6"
                                            AutomationProperties.Name="{loc:Loc Menus.NewMenuAutomation}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnImportMenus" Content="{loc:Loc Menus.Import}" Padding="8,6"
                                                Click="BtnImportMenus_Click"
                                                ToolTip="{loc:Loc Menus.ImportToolTip}"
                                                AutomationProperties.Name="{loc:Loc Menus.ImportAutomation}"/>
                                        <Button x:Name="BtnExportMenus" Grid.Column="2" Content="{loc:Loc Menus.Export}" Padding="8,6"
                                                Click="BtnExportMenus_Click"
                                                ToolTip="{loc:Loc Menus.ExportToolTip}"
                                                AutomationProperties.Name="{loc:Loc Menus.ExportAutomation}"/>
                                    </Grid>
                                    <Grid x:Name="PnlProfileActions">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnDuplicateMenuProfile" Content="{loc:Loc Menus.Duplicate}" Padding="8,6"
                                                Click="BtnDuplicateMenuProfile_Click"
                                                AutomationProperties.Name="{loc:Loc Menus.DuplicateAutomation}"/>
                                        <Button x:Name="BtnRemoveMenuProfile" Grid.Column="2" Content="{loc:Loc Common.Remove}" Padding="8,6"
                                                Click="BtnRemoveMenuProfile_Click"
                                                AutomationProperties.Name="{loc:Loc Menus.RemoveAutomation}"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="2,0,2,0">
                                    <ListBox x:Name="ListMenuProfiles" SelectionChanged="ListMenuProfiles_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="profileName" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <Border x:Name="profileOff" Grid.Column="1" Background="{DynamicResource TrackBrush}"
                                                                CornerRadius="6" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Loc Menus.DisabledBadge}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextDimBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="profileScope" Text="{Binding ProcessName, Converter={StaticResource LocFormat}, ConverterParameter=Menus.ProcessFormat}"
                                                               Style="{StaticResource CardHint}" FontSize="10.5" Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ProcessName}" Value="">
                                                        <Setter TargetName="profileScope" Property="Text" Value="{loc:Loc Menus.AnyApp}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProcessName}" Value="{x:Null}">
                                                        <Setter TargetName="profileScope" Property="Text" Value="{loc:Loc Menus.AnyApp}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter TargetName="profileName" Property="Foreground"
                                                                Value="{DynamicResource TextDimBrush}"/>
                                                        <Setter TargetName="profileOff" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <ScrollViewer x:Name="MenusScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel Margin="0,0,10,12">

                                <StackPanel x:Name="PnlProfileEditor">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Menus.ConditionsTitle}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="{loc:Loc Menus.ConditionsHint}"
                                                       Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Menus.NameLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="TxtProfileName" MaxLength="60" TextChanged="ProfileField_Changed"
                                                             LostFocus="TxtProfileName_LostFocus"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkProfileEnabled" Grid.Column="2" Content="{loc:Loc Menus.Active}"
                                                          VerticalAlignment="Bottom" Margin="0,0,0,7"
                                                          Checked="ProfileField_Changed" Unchecked="ProfileField_Changed"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc Menus.ProcessLabel}" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtProfileProcess" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                                    <TextBlock Text="{loc:Loc Menus.ProcessHint}" Style="{StaticResource FieldHint}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{loc:Loc Menus.TitleContains}" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtProfileTitle" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                                    <TextBlock Text="{loc:Loc Menus.TitleHint}" Style="{StaticResource FieldHint}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource Divider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Menus.Priority}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                <Border Grid.Column="1" Style="{StaticResource ValuePill}" MinWidth="48"
                                                        VerticalAlignment="Top">
                                                    <TextBlock x:Name="TxtPriorityValue" Style="{StaticResource ValueText}"
                                                               MinWidth="36" Text="0"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{loc:Loc Menus.PriorityHint}"
                                                       Style="{StaticResource FieldHint}" Margin="0,0,0,4"/>
                                            <Slider x:Name="SliderProfilePriority" Minimum="-100" Maximum="100" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                                    ValueChanged="ProfileField_Changed" AutomationProperties.Name="{loc:Loc Menus.PriorityAutomation}"/>

                                            <TextBlock Text="{loc:Loc Menus.ContextsLabel}" Style="{StaticResource FieldLabel}"/>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                <UniformGrid x:Name="PnlContexts" Columns="2"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Menus.ItemsTitle}" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="{loc:Loc Menus.ItemsHint}"
                                                           Style="{StaticResource CardHint}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                                    Padding="7,1" VerticalAlignment="Top" Margin="8,0,0,0">
                                                <TextBlock x:Name="MenuItemCount" Text="{loc:Loc Menus.ItemsCountZero}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           AutomationProperties.Name="{loc:Loc Menus.ItemsCountAutomation}"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnAddMenuItem" Content="{loc:Loc Common.Add}" Padding="8,6"
                                                                Click="BtnAddMenuItem_Click" AutomationProperties.Name="{loc:Loc Menus.AddItemAutomation}"/>
                                                        <Button x:Name="BtnRemoveMenuItem" Grid.Column="2" Content="{loc:Loc Common.Remove}" Padding="8,6"
                                                                Click="BtnRemoveMenuItem_Click" AutomationProperties.Name="{loc:Loc Menus.RemoveItemAutomation}"/>
                                                    </Grid>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnMoveItemUp" Content="{loc:Loc Common.MoveUp}" Padding="8,6"
                                                                Click="BtnMoveItemUp_Click" AutomationProperties.Name="{loc:Loc Menus.MoveItemUpAutomation}"/>
                                                        <Button x:Name="BtnMoveItemDown" Grid.Column="2" Content="{loc:Loc Common.MoveDown}" Padding="8,6"
                                                                Click="BtnMoveItemDown_Click" AutomationProperties.Name="{loc:Loc Menus.MoveItemDownAutomation}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <Grid>
                                                    <ListBox x:Name="ListItems" SelectionChanged="ListItems_SelectionChanged" MinHeight="210"
                                                             Padding="4" FontSize="12">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="itemGlyph" Text="{Binding Glyph}"
                                                                               FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                                                    <TextBlock x:Name="itemLabel" Grid.Column="1" Text="{Binding Label}"
                                                                               ToolTip="{Binding Label}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="itemSubmenuBadge" Grid.Column="2"
                                                                               Text="{Binding Options.Count, Converter={StaticResource LocFormat}, ConverterParameter=Menus.SubmenuBadgeFormat}"
                                                                               FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                                                                </Grid>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Glyph}" Value="">
                                                                        <Setter TargetName="itemGlyph" Property="Text" Value="&#xE734;"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter TargetName="itemLabel" Property="Foreground"
                                                                                Value="{DynamicResource TextDimBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Submenu">
                                                                        <Setter TargetName="itemSubmenuBadge" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <StackPanel x:Name="PnlNoItems" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsHitTestVisible="False" Margin="6">
                                                        <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="18"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="16"/>
                                                        </Border>
                                                        <TextBlock Text="{loc:Loc Menus.NoItems}" FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{loc:Loc Menus.NoItemsHint}" Style="{StaticResource CardHint}"
                                                                   FontSize="11" TextAlignment="Center" MaxWidth="120" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DockPanel>

                                            <Grid Grid.Column="2">
                                                <StackPanel x:Name="PnlItemEditor">
                                                    <ContentControl Content="{loc:Loc Menus.AppearanceSection}" Style="{StaticResource SectionHeader}" Margin="2,0,0,4"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc Common.Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                        <TextBox x:Name="TxtItemLabel" MaxLength="24" TextChanged="ItemField_Changed"
                                                                 LostFocus="TxtItemLabel_LostFocus"/>
                                                        <TextBlock Text="{loc:Loc Common.Icon}" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                                        <ComboBox x:Name="CmbItemGlyph" Width="180" HorizontalAlignment="Left"
                                                                  SelectionChanged="ItemField_Changed">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                                   FontSize="15" Width="22" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Label}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <TextBlock Text="{loc:Loc Common.DescriptionOptional}" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtItemDescription" MaxLength="120" TextChanged="ItemField_Changed"/>
                                                    <CheckBox x:Name="ChkItemEnabled" Content="{loc:Loc Menus.ItemActive}" Margin="0,8,0,0"
                                                              Checked="ItemField_Changed" Unchecked="ItemField_Changed"/>

                                                    <Border Style="{StaticResource Divider}" Margin="0,12,0,10"/>

                                                    <ContentControl Content="{loc:Loc Menus.ActionSection}" Style="{StaticResource SectionHeader}" Margin="2,0,0,4"/>
                                                    <TextBlock Text="{loc:Loc Menus.ItemKind}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="CmbItemKind" SelectionChanged="CmbItemKind_SelectionChanged"/>

                                                    <Border x:Name="BdItemTarget" Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="12,2,12,10" Margin="0,10,0,0">
                                                        <Grid>
                                                            <StackPanel x:Name="PnlItemAction">
                                                                <TextBlock Text="{loc:Loc Choices.Kind.Action}" Style="{StaticResource FieldLabel}"/>
                                                                <ComboBox x:Name="CmbItemAction" SelectionChanged="ItemField_Changed"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemLaunch">
                                                                <TextBlock Text="{loc:Loc Menus.Executable}" Style="{StaticResource FieldLabel}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtItemLaunch" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                                    <Button Grid.Column="1" Content="{loc:Loc Common.Browse}" Margin="8,0,0,0" Padding="10,6"
                                                                            Click="BtnBrowseExecutable_Click"/>
                                                                </Grid>
                                                                <TextBlock Text="{loc:Loc Menus.ExecutableHint}"
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemUrl">
                                                                <TextBlock Text="{loc:Loc Menus.UrlLabel}" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemUrl" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemPath">
                                                                <TextBlock Text="{loc:Loc Menus.PathLabel}" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemPath" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Button Content="{loc:Loc Menus.FileButton}" Padding="10,6" Margin="0,0,6,0" Click="BtnBrowseFile_Click"/>
                                                                    <Button Content="{loc:Loc Menus.FolderButton}" Padding="10,6" Click="BtnBrowseFolder_Click"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{loc:Loc Menus.PathHint}"
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemHotkey">
                                                                <TextBlock Text="{loc:Loc Menus.HotkeyLabel}" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemHotkey" MaxLength="80" TextChanged="ItemField_Changed"/>
                                                                <TextBlock Text="{loc:Loc Menus.HotkeyHint}"
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemText">
                                                                <TextBlock Text="{loc:Loc Menus.TextLabel}" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemText" MaxLength="4096" Height="86" AcceptsReturn="True"
                                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                                         TextChanged="ItemField_Changed"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel x:Name="PnlItemSubmenu" Visibility="Collapsed">
                                                        <ContentControl Content="{loc:Loc Menus.SubmenuSection}" Style="{StaticResource SectionHeader}" Margin="2,12,0,4"/>
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock x:Name="TxtSubmenuCount" Text="{loc:Loc Menus.SubmenuCountZero}"
                                                                                   FontSize="12.5" FontWeight="SemiBold"/>
                                                                        <TextBlock x:Name="TxtSubmenuPreview" Text="{loc:Loc Menus.NoOptionsYet}"
                                                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="BtnEditSubmenuOptions" Grid.Column="1" Content="{loc:Loc Menus.EditOptions}"
                                                                            Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                            Click="BtnEditSubmenuOptions_Click"
                                                                            AutomationProperties.Name="{loc:Loc Menus.EditOptionsAutomation}"/>
                                                                </Grid>
                                                                <TextBlock Text="{loc:Loc Menus.SubmenuHint}"
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel x:Name="PnlItemRoutine" Visibility="Collapsed">
                                                        <ContentControl Content="{loc:Loc Menus.RoutineSection}" Style="{StaticResource SectionHeader}" Margin="2,12,0,4"/>
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock x:Name="TxtRoutineCount" Text="{loc:Loc Menus.RoutineCountZero}"
                                                                                   FontSize="12.5" FontWeight="SemiBold"/>
                                                                        <TextBlock x:Name="TxtRoutinePreview" Text="{loc:Loc Menus.NoStepsYet}"
                                                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="BtnEditRoutineSteps" Grid.Column="1" Content="{loc:Loc Menus.EditSteps}"
                                                                            Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                            Click="BtnEditRoutineSteps_Click"
                                                                            AutomationProperties.Name="{loc:Loc Menus.EditStepsAutomation}"/>
                                                                </Grid>
                                                                <TextBlock x:Name="TxtRoutineWarning" FontSize="11.5" TextWrapping="Wrap"
                                                                           Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}"
                                                                           Visibility="Collapsed"/>
                                                                <TextBlock Text="{loc:Loc Menus.RoutineHint}"
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border x:Name="PnlNoItemSelected" Background="{DynamicResource CardSurfaceBrush}"
                                                        BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                                                        CornerRadius="14" Padding="20" Visibility="Collapsed">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240">
                                                        <Border Style="{StaticResource IconBadge}" Width="44" Height="44" CornerRadius="22"
                                                                HorizontalAlignment="Center">
                                                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;" FontSize="19"/>
                                                        </Border>
                                                        <TextBlock Text="{loc:Loc Menus.NoItemSelected}" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{loc:Loc Menus.NoItemSelectedHint}"
                                                                   Style="{StaticResource CardHint}" FontSize="11.5" TextAlignment="Center"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Menus.PreviewTitle}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="PreviewContext" Style="{StaticResource CardHint}"/>

                                        <!-- Empilhado: em janela estreita uma coluna de texto ao lado da roda ficaria ilegível. -->
                                        <Border x:Name="MenuPreviewHost" Width="280" Height="280"
                                                Margin="0,14,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                        <TextBlock x:Name="PreviewSummary" Style="{StaticResource CardHint}"
                                                   Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PreviewWarning" Style="{StaticResource CardHint}" Margin="0,8,0,0"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>

                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc Menus.Legend}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                                <WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlBrush}"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{loc:Loc Menus.LegendAutomatic}" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="{loc:Loc Menus.LegendReplaces}" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{loc:Loc Menus.LegendExtra}" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                                ToolTip="{loc:Loc Menus.SubmenuLegendToolTip}">
                                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <TextBlock Text="{loc:Loc Menus.LegendSubmenu}" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource CardHint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Text="{loc:Loc Menus.PreviewHint}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="PnlNoProfileSelected" Grid.Column="2" Style="{StaticResource Card}"
                                Padding="24,40" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource IconBadge}" Width="48" Height="48" CornerRadius="24"
                                        HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8FD;" FontSize="21"/>
                                </Border>
                                <TextBlock Text="{loc:Loc Menus.NoProfileSelected}" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="{loc:Loc Menus.NoProfileSelectedHint}"
                                           Style="{StaticResource CardHint}" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="PnlNoMenus" Grid.Row="1" Margin="32,4,20,20" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0" Padding="36,34" MaxWidth="560"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc Menus.EmptyTitle}" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="{loc:Loc Menus.EmptyHint}"
                                           Style="{StaticResource CardHint}" FontSize="12.5" MaxWidth="420"
                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                <Button x:Name="BtnAddMenuProfile" Content="{loc:Loc Menus.CreateFirst}"
                                        Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="0,20,0,0"
                                        HorizontalAlignment="Center" Click="BtnAddMenuProfile_Click"
                                        AutomationProperties.Name="{loc:Loc Menus.CreateFirstAutomation}"/>
                                <Button x:Name="BtnImportMenusEmpty" Content="{loc:Loc Menus.ImportFromFile}"
                                        MinWidth="180" Padding="12,7" Margin="0,8,0,0"
                                        HorizontalAlignment="Center" Click="BtnImportMenus_Click"
                                        AutomationProperties.Name="{loc:Loc Menus.ImportFromFileAutomation}"/>
                                <TextBlock Text="{loc:Loc Menus.EmptyFooterHint}"
                                           Style="{StaticResource CardHint}" FontSize="11"
                                           TextAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= CONVERSORES (lista montada em código: SettingsWindow.Converters.cs) ================= -->
            <TabItem Header="{loc:Loc Settings.Converters}" Tag="{StaticResource IconConverters}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="{loc:Loc Converters.PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc Converters.PageSubtitle}"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,4,20,20">
                            <ContentControl Content="{loc:Loc Converters.AvailableSection}" Style="{StaticResource SectionHeader}" Margin="3,0,0,7"/>
                            <StackPanel x:Name="ConverterList"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Converters.Installation}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ConverterStatus" Style="{StaticResource CardHint}" Margin="0,3,0,12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnInstallConverters" Content="{loc:Loc Converters.InstallSelected}" Style="{StaticResource PrimaryButton}"
                                                Click="BtnInstallConverters_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="{loc:Loc Converters.InstallSelectedAutomation}"/>
                                        <Button x:Name="BtnRefreshConverters" Content="{loc:Loc Converters.Refresh}" Click="BtnRefreshConverters_Click"
                                                AutomationProperties.Name="{loc:Loc Converters.RefreshAutomation}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Converters.PhotosTitle}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,0"
                                               Text="{loc:Loc Converters.PhotosHint}"/>
                                    <TextBlock x:Name="WindowsCodecsStatus" Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= SOBRE ================= -->
            <TabItem Header="{loc:Loc Settings.About}" Tag="{StaticResource IconAbout}" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="{loc:Loc Settings.About}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{loc:Loc About.Subtitle}"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,4,20,20">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource AccentSoftBrush}"
                                                 Stroke="{DynamicResource AccentLineBrush}" StrokeThickness="1"/>
                                        <Ellipse Width="20" Height="20" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="3"/>
                                        <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource AccentTextBrush}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutTitle" Text="RadialFlow" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock x:Name="AboutVersion" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc About.Diagnostics}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,10"
                                               Text="{loc:Loc About.DiagnosticsHint}"/>
                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                        <TextBlock x:Name="LogPath" FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOpenLogs" Content="{loc:Loc About.OpenLogs}" Click="BtnOpenLogs_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="{loc:Loc About.OpenLogsAutomation}"/>
                                        <Button x:Name="BtnCopyLogPath" Content="{loc:Loc About.CopyPath}" Click="BtnCopyLogPath_Click"
                                                AutomationProperties.Name="{loc:Loc About.CopyPathAutomation}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc About.HowToUse}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.HowToUse1}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.HowToUse2}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.HowToUse3}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.HowToUse4}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="{loc:Loc About.HowToUse5}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc About.ContextSlices}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.ContextSlices1}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.ContextSlices2}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="{loc:Loc About.ContextSlices3}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="{loc:Loc About.ContextSlices4}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= RODAPÉ ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource WarningBrush}"
                             Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="SaveStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                               Text="{loc:Loc Settings.AllSaved}"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="{loc:Loc Common.Save}" Style="{StaticResource PrimaryButton}" MinWidth="104"
                            Click="BtnSave_Click" Margin="0,0,8,0" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="{loc:Loc Common.Close}" MinWidth="92" Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
