<Window x:Class="RadialFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialFlow — Configurações"
        Width="760" Height="640"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor, antes do InitializeComponent). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,18,28,16">
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentBrush}"/>
                    <Ellipse Width="14" Height="14" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="3"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RadialFlow" Style="{StaticResource WindowTitle}"/>
                    <TextBlock Text="Configurações" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="28,20,28,0">

            <!-- ABA 1: GERAL. O ScrollViewer fica numa linha "*" do TabControl: recebe altura finita e rola. -->
            <TabItem Header="Geral">
                <ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,14,12">

                        <TextBlock Text="SISTEMA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ChkStartWithWindows" Margin="0,2,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold"/>
                                        <TextBlock Text="Abre o RadialFlow ao entrar na sua conta, já com privilégios de administrador." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkBlockFullscreen" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Pausar em tela cheia exclusiva" FontWeight="SemiBold"/>
                                        <TextBlock Text="Desativa o gesto em jogos e players de vídeo, para não atrapalhar o botão direito." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GESTO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sensibilidade" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Quantos pixels arrastar com o botão direito para abrir a roda. Menor = abre mais fácil." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" MinWidth="64" VerticalAlignment="Top"
                                               Text="{Binding ElementName=SliderDeadzone, Path=Value, StringFormat='{}{0:0} px'}"/>
                                </Grid>
                                <Slider x:Name="SliderDeadzone" Minimum="8" Maximum="40" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="Sensibilidade do gesto, em pixels"
                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0"/>

                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,18,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tempo para abrir opções" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Quanto tempo manter o cursor sobre uma fatia com submenu (como Converter) até ele abrir. Um traço na borda da fatia mostra o tempo restante. Maior = mais tempo para decidir." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" MinWidth="64" VerticalAlignment="Top"
                                               Text="{Binding ElementName=SliderDwell, Path=Value, StringFormat='{}{0:0} ms'}"/>
                                </Grid>
                                <Slider x:Name="SliderDwell" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="250"
                                        AutomationProperties.Name="Tempo para abrir opções, em milissegundos"
                                        IsSnapToTickEnabled="True" TickFrequency="50" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APARÊNCIA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Cor de destaque" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Cor da fatia sob o cursor e destes controles. A roda e as janelas seguem o tema claro/escuro do Windows."/>
                                <StackPanel x:Name="AccentChips" Orientation="Horizontal" Margin="0,14,0,0"/>
                                <TextBlock x:Name="AccentName" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: BLACKLIST -->
            <TabItem Header="Blacklist">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,0,12">
                        <TextBlock Text="Programas ignorados" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Nestes programas o botão direito fica livre (câmeras 3D, viewports, jogos)." Style="{StaticResource CardHint}"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="ListBlacklist">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Processo (sem .exe)" Width="210" DisplayMemberBinding="{Binding ProcessName}"/>
                                <GridViewColumn Header="Descrição" Width="400" DisplayMemberBinding="{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAddBlacklist" Content="Adicionar…" Style="{StaticResource PrimaryButton}" Click="BtnAddBlacklist_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRemoveBlacklist" Content="Remover selecionado" Click="BtnRemoveBlacklist_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnResetBlacklist" Content="Restaurar padrões" Click="BtnResetBlacklist_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 3: APPS FAVORITOS -->
            <TabItem Header="Apps Favoritos">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,0,12">
                        <TextBlock Text="Atalhos da fatia “Apps favoritos”" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Aparecem ao arrastar sobre a área de trabalho ou um fundo vazio. Abrem sem privilégios de administrador." Style="{StaticResource CardHint}"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="ListFavorites">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Caminho / Executável" Width="290" DisplayMemberBinding="{Binding ExecutablePath}"/>
                                <GridViewColumn Header="Argumentos" Width="160" DisplayMemberBinding="{Binding Arguments}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAddFavorite" Content="Adicionar app…" Style="{StaticResource PrimaryButton}" Click="BtnAddFavorite_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRemoveFavorite" Content="Remover selecionado" Click="BtnRemoveFavorite_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnResetFavorites" Content="Restaurar padrões" Click="BtnResetFavorites_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 4: SOBRE -->
            <TabItem Header="Sobre">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AboutTitle" Text="RadialFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,10"
                                           Text="Se algo não funcionar, o registro de eventos mostra o que aconteceu. Ele guarda falhas, ações e inicialização, e é girado sozinho para não ocupar espaço."/>
                                <TextBlock x:Name="LogPath" FontFamily="Consolas, Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenLogs" Content="Abrir pasta de logs" Click="BtnOpenLogs_Click" Margin="0,0,8,0"
                                            AutomationProperties.Name="Abrir a pasta dos logs no Explorer"/>
                                    <Button x:Name="BtnCopyLogPath" Content="Copiar caminho" Click="BtnCopyLogPath_Click"
                                            AutomationProperties.Name="Copiar o caminho do arquivo de log"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Como usar" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Segure e arraste com o botão direito para abrir a roda."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte sobre uma fatia para executá-la."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Fatias com seta ⌄ têm submenu: segure o cursor sobre elas."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte no centro do anel para cancelar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Um clique direito simples, sem arrastar, abre o menu normal do Windows."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Fatias por contexto" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Arquivos e pastas: Comprimir, Converter, Copiar caminho, Mover, Enviar e Renomear."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Barra de título: Maximizar, Snap, Transparência, Sempre no topo, Minimizar e Fechar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Campos de texto: Colar, Traduzir, Pesquisar, Formatar e Limpar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Área de trabalho: Apps favoritos, Sistema, Área de transferência e Bloquear."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Rodapé ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSave" Content="Salvar" Style="{StaticResource PrimaryButton}" MinWidth="104" Click="BtnSave_Click" Margin="0,0,8,0" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Fechar" MinWidth="92" Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
