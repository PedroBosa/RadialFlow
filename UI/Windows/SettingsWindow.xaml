<Window x:Class="RadialFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialFlow — Configurações"
        Width="760" Height="640"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor, antes do InitializeComponent). -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,18,28,16">
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource AccentBrush}"/>
                    <Ellipse Width="14" Height="14" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="3"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RadialFlow" Style="{StaticResource WindowTitle}"/>
                    <TextBlock Text="Configurações" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="28,20,28,0">

            <!-- ABA 1: GERAL. O ScrollViewer fica numa linha "*" do TabControl: recebe altura finita e rola. -->
            <TabItem Header="Geral">
                <ScrollViewer x:Name="GeneralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,14,12">

                        <TextBlock Text="SISTEMA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ChkStartWithWindows" Margin="0,2,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Iniciar com o Windows" FontWeight="SemiBold"/>
                                        <TextBlock Text="O RadialFlow abre sozinho quando você entra no Windows." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkBlockFullscreen" Margin="0,0,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Pausar em tela cheia exclusiva" FontWeight="SemiBold"/>
                                        <TextBlock Text="Em jogos e vídeos em tela cheia, o botão direito volta a funcionar normalmente." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GESTO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sensibilidade" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Quanto é preciso arrastar com o botão direito para a roda abrir. Valores menores abrem a roda com menos movimento." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" MinWidth="64" VerticalAlignment="Top"
                                               Text="{Binding ElementName=SliderDeadzone, Path=Value, StringFormat='{}{0:0} px'}"/>
                                </Grid>
                                <Slider x:Name="SliderDeadzone" Minimum="8" Maximum="40" SmallChange="1" LargeChange="5"
                                        AutomationProperties.Name="Sensibilidade do gesto, em pixels"
                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0"/>

                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,18,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tempo para abrir opções" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="Quanto tempo o cursor precisa ficar sobre uma fatia com mais opções (como Converter) para elas aparecerem. Um traço na borda da fatia mostra quando vai abrir." Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" MinWidth="64" VerticalAlignment="Top"
                                               Text="{Binding ElementName=SliderDwell, Path=Value, StringFormat='{}{0:0} ms'}"/>
                                </Grid>
                                <Slider x:Name="SliderDwell" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="250"
                                        AutomationProperties.Name="Tempo para abrir opções, em milissegundos"
                                        IsSnapToTickEnabled="True" TickFrequency="50" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APARÊNCIA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="4,8,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Cor de destaque" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}"
                                           Text="Cor da fatia sob o cursor e dos botões. O claro ou escuro segue o tema do Windows."/>
                                <StackPanel x:Name="AccentChips" Orientation="Horizontal" Margin="0,14,0,0"/>
                                <TextBlock x:Name="AccentName" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: BLACKLIST -->
            <TabItem Header="Blacklist">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,0,12">
                        <TextBlock Text="Programas ignorados" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Nestes programas a roda não abre e o botão direito funciona como sempre. Útil em programas 3D e jogos, que usam o botão direito para mexer a câmera." Style="{StaticResource CardHint}"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="ListBlacklist">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Processo (sem .exe)" Width="210" DisplayMemberBinding="{Binding ProcessName}"/>
                                <GridViewColumn Header="Descrição" Width="400" DisplayMemberBinding="{Binding Description}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAddBlacklist" Content="Adicionar…" Style="{StaticResource PrimaryButton}" Click="BtnAddBlacklist_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRemoveBlacklist" Content="Remover selecionado" Click="BtnRemoveBlacklist_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnResetBlacklist" Content="Restaurar padrões" Click="BtnResetBlacklist_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 3: APPS FAVORITOS -->
            <TabItem Header="Apps Favoritos">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,0,0,12">
                        <TextBlock Text="Atalhos da fatia “Apps favoritos”" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Aparecem quando você abre a roda sobre a área de trabalho ou um espaço vazio de uma pasta." Style="{StaticResource CardHint}"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="ListFavorites">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nome" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Caminho / Executável" Width="290" DisplayMemberBinding="{Binding ExecutablePath}"/>
                                <GridViewColumn Header="Argumentos" Width="160" DisplayMemberBinding="{Binding Arguments}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnAddFavorite" Content="Adicionar app…" Style="{StaticResource PrimaryButton}" Click="BtnAddFavorite_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRemoveFavorite" Content="Remover selecionado" Click="BtnRemoveFavorite_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnResetFavorites" Content="Restaurar padrões" Click="BtnResetFavorites_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 4: MENUS PERSONALIZADOS (editor em código: SettingsWindow.Menus.cs) -->
            <TabItem Header="Menus">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                            <TextBlock Text="Menus personalizados" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardHint}"
                                       Text="Itens extras por aplicativo, janela ou contexto. Eles somam à roda e podem substituir uma fatia automática."/>
                        </StackPanel>

                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button x:Name="BtnAddMenuProfile" Content="Novo" Style="{StaticResource PrimaryButton}"
                                    Click="BtnAddMenuProfile_Click" Padding="12,7" Margin="0,0,6,6"
                                    AutomationProperties.Name="Adicionar menu personalizado"/>
                            <Button x:Name="BtnDuplicateMenuProfile" Content="Duplicar" Click="BtnDuplicateMenuProfile_Click"
                                    Padding="10,7" Margin="0,0,6,6" AutomationProperties.Name="Duplicar menu selecionado"/>
                            <Button x:Name="BtnRemoveMenuProfile" Content="Remover" Click="BtnRemoveMenuProfile_Click"
                                    Padding="10,7" Margin="0,0,0,6" AutomationProperties.Name="Remover menu selecionado"/>
                        </WrapPanel>

                        <ListBox x:Name="ListMenuProfiles" SelectionChanged="ListMenuProfiles_SelectionChanged" DisplayMemberPath="Name"/>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel Margin="0,0,10,12">

                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="PnlProfileEditor">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nome do menu" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="TxtProfileName" MaxLength="60" TextChanged="ProfileField_Changed"
                                                     LostFocus="TxtProfileName_LostFocus"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkProfileEnabled" Grid.Column="1" Content="Ativo" VerticalAlignment="Bottom"
                                                  Margin="14,0,0,8" Checked="ProfileField_Changed" Unchecked="ProfileField_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Processo (sem .exe)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtProfileProcess" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                            <TextBlock Text="Vazio = qualquer aplicativo." Style="{StaticResource FieldHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Título contém" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtProfileTitle" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                            <TextBlock Text="Vazio = qualquer título." Style="{StaticResource FieldHint}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Prioridade (maior vence)" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="TxtPriorityValue" Grid.Column="1" Style="{StaticResource ValueText}"
                                                   MinWidth="36" Text="0"/>
                                    </Grid>
                                    <Slider x:Name="SliderProfilePriority" Minimum="-100" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                            ValueChanged="ProfileField_Changed" AutomationProperties.Name="Prioridade do menu"/>

                                    <TextBlock Text="Contextos (nenhum marcado = todos)" Style="{StaticResource FieldLabel}"/>
                                    <WrapPanel x:Name="PnlContexts"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Itens do menu" Style="{StaticResource CardTitle}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnAddMenuItem" Content="Adicionar" Padding="6,6" Margin="0,0,4,0"
                                                            Click="BtnAddMenuItem_Click" AutomationProperties.Name="Adicionar item ao menu"/>
                                                    <Button x:Name="BtnRemoveMenuItem" Grid.Column="1" Content="Remover" Padding="6,6"
                                                            Margin="4,0,0,0" Click="BtnRemoveMenuItem_Click" AutomationProperties.Name="Remover item selecionado"/>
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnMoveItemUp" Content="Subir" Padding="6,6" Margin="0,0,4,0"
                                                            Click="BtnMoveItemUp_Click" AutomationProperties.Name="Mover item para cima"/>
                                                    <Button x:Name="BtnMoveItemDown" Grid.Column="1" Content="Descer" Padding="6,6"
                                                            Margin="4,0,0,0" Click="BtnMoveItemDown_Click" AutomationProperties.Name="Mover item para baixo"/>
                                                </Grid>
                                            </StackPanel>
                                            <ListBox x:Name="ListItems" SelectionChanged="ListItems_SelectionChanged"
                                                     DisplayMemberPath="Label" MinHeight="190"/>
                                        </DockPanel>

                                        <StackPanel x:Name="PnlItemEditor" Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Rótulo" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="TxtItemLabel" MaxLength="24" TextChanged="ItemField_Changed"
                                                             LostFocus="TxtItemLabel_LostFocus"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="Ícone" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="CmbItemGlyph" Width="132" SelectionChanged="ItemField_Changed">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                               FontSize="15" Width="22" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Label}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Descrição (opcional)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtItemDescription" MaxLength="120" TextChanged="ItemField_Changed"/>
                                            <CheckBox x:Name="ChkItemEnabled" Content="Item ativo"
                                                      Checked="ItemField_Changed" Unchecked="ItemField_Changed"/>

                                            <TextBlock Text="Tipo de item" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbItemKind" SelectionChanged="CmbItemKind_SelectionChanged"/>

                                            <StackPanel x:Name="PnlItemAction">
                                                <TextBlock Text="Ação do RadialFlow" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="CmbItemAction" SelectionChanged="ItemField_Changed"/>
                                            </StackPanel>

                                            <StackPanel x:Name="PnlItemLaunch">
                                                <TextBlock Text="Executável" Style="{StaticResource FieldLabel}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtItemLaunch" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                    <Button Grid.Column="1" Content="Procurar…" Margin="8,0,0,0" Padding="10,6"
                                                            Click="BtnBrowseExecutable_Click"/>
                                                </Grid>
                                                <TextBlock Text="Só executáveis em pastas protegidas (System32, Program Files). Sem argumentos."
                                                           Style="{StaticResource FieldHint}"/>
                                            </StackPanel>

                                            <StackPanel x:Name="PnlItemUrl">
                                                <TextBlock Text="Endereço (http ou https)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtItemUrl" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                            </StackPanel>

                                            <StackPanel x:Name="PnlItemPath">
                                                <TextBlock Text="Arquivo ou pasta" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtItemPath" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="Arquivo…" Padding="10,6" Margin="0,0,6,0" Click="BtnBrowseFile_Click"/>
                                                    <Button Content="Pasta…" Padding="10,6" Click="BtnBrowseFolder_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="Executáveis, scripts e atalhos são recusados aqui; para eles use Executável."
                                                           Style="{StaticResource FieldHint}"/>
                                            </StackPanel>

                                            <StackPanel x:Name="PnlItemHotkey">
                                                <TextBlock Text="Atalho (ex.: Ctrl+Shift+P)" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtItemHotkey" MaxLength="80" TextChanged="ItemField_Changed"/>
                                                <TextBlock Text="Modificadores Ctrl/Alt/Shift/Win e uma tecla final. O foco precisa estar na janela de origem."
                                                           Style="{StaticResource FieldHint}"/>
                                            </StackPanel>

                                            <StackPanel x:Name="PnlItemText">
                                                <TextBlock Text="Texto a colar" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="TxtItemText" MaxLength="4096" Height="86" AcceptsReturn="True"
                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ItemField_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Prévia da roda" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="PreviewContext" Style="{StaticResource CardHint}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MenuPreviewHost" Width="280" Height="280"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="PreviewSummary" Style="{StaticResource CardHint}"/>
                                            <TextBlock x:Name="PreviewWarning" Style="{StaticResource CardHint}" Margin="0,8,0,0"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource CardHint}" Margin="0,10,0,0"
                                                       Text="Fatias em destaque vêm deste menu; as demais são automáticas do contexto. Itens além do limite de 8 ficam de fora da roda."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ABA 5: CONVERSORES (lista montada em código: SettingsWindow.Converters.cs) -->
            <TabItem Header="Conversores">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Programas gratuitos para converter mais formatos" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,0"
                                           Text="Imagens comuns já convertem sem instalar nada. Para vídeo, áudio, documentos e outros formatos, marque o que quiser e clique em Instalar. Os arquivos vêm do site oficial de cada programa e são conferidos antes de instalar."/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ConverterList"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="ConverterStatus" Style="{StaticResource CardHint}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnInstallConverters" Content="Instalar selecionados" Style="{StaticResource PrimaryButton}"
                                            Click="BtnInstallConverters_Click" Margin="0,0,8,0"
                                            AutomationProperties.Name="Instalar os conversores selecionados"/>
                                    <Button x:Name="BtnRefreshConverters" Content="Verificar de novo" Click="BtnRefreshConverters_Click"
                                            AutomationProperties.Name="Verificar de novo quais conversores estão instalados"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Fotos WebP, HEIC e AVIF" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,0"
                                           Text="Essas fotos são lidas pelo próprio Windows, com as extensões gratuitas da Microsoft Store: Extensões de Imagem HEIF, Extensões de Imagem da Web e Extensão de Imagem Bruta (o Windows 11 geralmente já tem)."/>
                                <TextBlock x:Name="WindowsCodecsStatus" Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 6: SOBRE -->
            <TabItem Header="Sobre">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="AboutTitle" Text="RadialFlow" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,10"
                                           Text="Se algo não funcionar, o registro mostra o que aconteceu. Ele não cresce sem limite: os arquivos antigos são apagados sozinhos."/>
                                <TextBlock x:Name="LogPath" FontFamily="Consolas, Cascadia Mono" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenLogs" Content="Abrir pasta de logs" Click="BtnOpenLogs_Click" Margin="0,0,8,0"
                                            AutomationProperties.Name="Abrir a pasta dos logs no Explorer"/>
                                    <Button x:Name="BtnCopyLogPath" Content="Copiar caminho" Click="BtnCopyLogPath_Click"
                                            AutomationProperties.Name="Copiar o caminho do arquivo de log"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Como usar" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Segure e arraste com o botão direito para abrir a roda."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte sobre uma fatia para executá-la."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Fatias com seta ⌄ têm submenu: segure o cursor sobre elas."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte no centro do anel para cancelar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Um clique direito simples, sem arrastar, abre o menu normal do Windows."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Fatias por contexto" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Arquivos e pastas: Comprimir, Converter, Copiar caminho, Mover, Enviar e Renomear."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Barra de título: Maximizar, Snap, Transparência, Sempre no topo, Minimizar e Fechar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Campos de texto: Colar, Traduzir, Pesquisar, Formatar e Limpar."/>
                                <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Área de trabalho: Apps favoritos, Ajustes rápidos, Área de transferência e Bloquear."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Rodapé ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSave" Content="Salvar" Style="{StaticResource PrimaryButton}" MinWidth="104" Click="BtnSave_Click" Margin="0,0,8,0" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Fechar" MinWidth="92" Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
