<Window x:Class="RadialFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialFlow — Configurações"
        Width="1040" Height="680"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor, antes do InitializeComponent). -->
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="3,10,0,7"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Margin" Value="0,14,0,14"/>
        </Style>
        <Style x:Key="ValueBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
        <Style x:Key="EndpointText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
        </Style>

        <!-- Navegação lateral: o cabeçalho de cada página fica no conteúdo da aba. -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="42" Margin="0,1">
                            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="8"/>
                            <Border x:Name="marker" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" Margin="13,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Width="26" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter TargetName="marker" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="216"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,22,18">
                                        <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                            <Ellipse Width="13" Height="13" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="2.5"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="RadialFlow" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Configurações" FontSize="11.5"
                                                       Foreground="{DynamicResource TextDimBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardBorderBrush}"
                                            Margin="16,0,16,6"/>

                                    <TextBlock DockPanel.Dock="Bottom" Text="Menu radial para Windows" FontSize="10.5"
                                               Foreground="{DynamicResource TextDimBrush}" Margin="22,12,22,16"
                                               TextWrapping="Wrap"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel IsItemsHost="True" Margin="10,2,10,4"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0" Style="{StaticResource SettingsTabControl}">

            <!-- ================= GERAL ================= -->
            <TabItem Header="Geral" Tag="&#xE713;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="Geral" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Inicialização, gesto e aparência. As alterações valem depois de salvar."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <!-- O ScrollViewer fica na linha "*" da página: recebe altura finita e rola. -->
                    <ScrollViewer x:Name="GeneralScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="32,4,20,20">

                            <TextBlock Text="INICIALIZAÇÃO" Style="{StaticResource SectionLabel}" Margin="3,0,0,7"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="Iniciar com o Windows" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="O RadialFlow abre sozinho quando você entra no Windows."
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkStartWithWindows" Grid.Column="1" Margin="0"
                                                  VerticalAlignment="Center" Checked="DirtyState_Changed"
                                                  Unchecked="DirtyState_Changed"
                                                  AutomationProperties.Name="Iniciar com o Windows"/>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="Pausar em tela cheia exclusiva" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Em jogos e vídeos em tela cheia, o botão direito volta a funcionar normalmente."
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkBlockFullscreen" Grid.Column="1" Margin="0"
                                                  VerticalAlignment="Center" Checked="DirtyState_Changed"
                                                  Unchecked="DirtyState_Changed"
                                                  AutomationProperties.Name="Pausar em tela cheia exclusiva"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="GESTO" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="Sensibilidade" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Quanto é preciso arrastar com o botão direito para a roda abrir. Valores menores abrem a roda com menos movimento."
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBadge}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource ValueText}"
                                                       Text="{Binding ElementName=SliderDeadzone, Path=Value, StringFormat='{}{0:0} px'}"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderDeadzone" Minimum="8" Maximum="40" SmallChange="1" LargeChange="5"
                                            AutomationProperties.Name="Sensibilidade do gesto, em pixels"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,12,0,0"
                                            ValueChanged="DirtyState_Changed"/>
                                    <Grid Margin="1,0,1,0">
                                        <TextBlock Text="8 px" Style="{StaticResource EndpointText}"/>
                                        <TextBlock Text="40 px" Style="{StaticResource EndpointText}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="Tempo para abrir opções" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Quanto tempo o cursor precisa ficar sobre uma fatia com mais opções (como Converter) para elas aparecerem. Um traço na borda da fatia mostra quando vai abrir."
                                                       Style="{StaticResource CardHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource ValueBadge}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource ValueText}"
                                                       Text="{Binding ElementName=SliderDwell, Path=Value, StringFormat='{}{0:0} ms'}"/>
                                        </Border>
                                    </Grid>
                                    <Slider x:Name="SliderDwell" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="250"
                                            AutomationProperties.Name="Tempo para abrir opções, em milissegundos"
                                            IsSnapToTickEnabled="True" TickFrequency="50" Margin="0,12,0,0"
                                            ValueChanged="DirtyState_Changed"/>
                                    <Grid Margin="1,0,1,0">
                                        <TextBlock Text="200 ms" Style="{StaticResource EndpointText}"/>
                                        <TextBlock Text="2000 ms" Style="{StaticResource EndpointText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Cor de destaque" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}"
                                               Text="Cor da fatia sob o cursor e dos botões. O claro ou escuro segue o tema do Windows."/>
                                    <StackPanel x:Name="AccentChips" Orientation="Horizontal" Margin="0,14,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                        <TextBlock Text="Selecionada:" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AccentName" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= BLACKLIST ================= -->
            <TabItem Header="Blacklist" Tag="&#xE72E;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="Programas ignorados" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Nestes programas a roda não abre e o botão direito funciona como sempre. Útil em programas 3D e jogos, que usam o botão direito para mexer a câmera."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,4,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BlacklistCount" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnResetBlacklist" Content="Restaurar padrões" Click="BtnResetBlacklist_Click"/>
                                <Button x:Name="BtnRemoveBlacklist" Content="Remover" IsEnabled="False" Margin="8,0,0,0"
                                        Click="BtnRemoveBlacklist_Click"/>
                                <Button x:Name="BtnAddBlacklist" Content="Adicionar…" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="BtnAddBlacklist_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ListBlacklist" Background="{DynamicResource CardBrush}" Padding="6"
                                     AutomationProperties.Name="Programas ignorados">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="18,0,0,0"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="PnlNoBlacklist" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="16" Visibility="Collapsed">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"
                                           Opacity="0.8"/>
                                <TextBlock Text="Nenhum programa ignorado" FontSize="13.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="A roda abre normalmente em todos os programas."
                                           Style="{StaticResource CardHint}" TextAlignment="Center"
                                           MaxWidth="300" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= APPS FAVORITOS ================= -->
            <TabItem Header="Apps Favoritos" Tag="&#xE734;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="Apps favoritos" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Atalhos da fatia “Apps favoritos”. Aparecem quando você abre a roda sobre a área de trabalho ou um espaço vazio de uma pasta."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="32,4,20,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FavoritesCount" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnResetFavorites" Content="Restaurar padrões" Click="BtnResetFavorites_Click"/>
                                <Button x:Name="BtnRemoveFavorite" Content="Remover" IsEnabled="False" Margin="8,0,0,0"
                                        Click="BtnRemoveFavorite_Click"/>
                                <Button x:Name="BtnAddFavorite" Content="Adicionar app…" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="BtnAddFavorite_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="ListFavorites" Background="{DynamicResource CardBrush}" Padding="6"
                                     AutomationProperties.Name="Apps favoritos">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0"
                                                    Background="{DynamicResource ControlBrush}" VerticalAlignment="Center">
                                                <TextBlock x:Name="favoriteGlyph" Text="{Binding Glyph}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ExecutablePath}" Margin="16,0,12,0"
                                                       Foreground="{DynamicResource TextDimBrush}" ToolTip="{Binding ExecutablePath}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Arguments}" MaxWidth="150"
                                                       Foreground="{DynamicResource TextDimBrush}" ToolTip="{Binding Arguments}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Glyph}" Value="">
                                                <Setter TargetName="favoriteGlyph" Property="Text" Value="&#xE734;"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Glyph}" Value="{x:Null}">
                                                <Setter TargetName="favoriteGlyph" Property="Text" Value="&#xE734;"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="PnlNoFavorites" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Margin="16" Visibility="Collapsed">
                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"
                                           Opacity="0.8"/>
                                <TextBlock Text="Nenhum app favorito" FontSize="13.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Adicione atalhos para abrir seus programas pela roda."
                                           Style="{StaticResource CardHint}" TextAlignment="Center"
                                           MaxWidth="300" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= MENUS PERSONALIZADOS (editor em código: SettingsWindow.Menus.cs) ================= -->
            <TabItem Header="Menus" Tag="&#xE8FD;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,14">
                        <TextBlock Text="Menus personalizados" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Crie menus que aparecem só nos aplicativos e contextos que você escolher. Cada item vira uma fatia da roda."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <Grid x:Name="MenusWorkspace" Grid.Row="1" Margin="32,4,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,14,14,12" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Seus menus" Style="{StaticResource CardTitle}"/>
                                        <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                                Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock x:Name="MenuProfileCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       AutomationProperties.Name="Total de menus"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Aparecem só onde as condições casarem." Style="{StaticResource CardHint}"
                                               FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Button x:Name="BtnNewMenuProfile" Content="Novo menu" Style="{StaticResource PrimaryButton}"
                                            Click="BtnAddMenuProfile_Click" Margin="0,0,0,6"
                                            AutomationProperties.Name="Adicionar menu personalizado"/>
                                    <Grid x:Name="PnlProfileActions">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnDuplicateMenuProfile" Content="Duplicar" Padding="8,6"
                                                Click="BtnDuplicateMenuProfile_Click"
                                                AutomationProperties.Name="Duplicar menu selecionado"/>
                                        <Button x:Name="BtnRemoveMenuProfile" Grid.Column="2" Content="Remover" Padding="8,6"
                                                Click="BtnRemoveMenuProfile_Click"
                                                AutomationProperties.Name="Remover menu selecionado"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="2,0,2,0">
                                    <ListBox x:Name="ListMenuProfiles" SelectionChanged="ListMenuProfiles_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="profileName" Text="{Binding Name}" FontWeight="SemiBold"
                                                                   ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                        <Border x:Name="profileOff" Grid.Column="1" Background="{DynamicResource TrackBrush}"
                                                                CornerRadius="6" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="DESATIVADO" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextDimBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="profileScope" Text="{Binding ProcessName, StringFormat='Processo: {0}'}"
                                                               Style="{StaticResource CardHint}" FontSize="10.5" Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ProcessName}" Value="">
                                                        <Setter TargetName="profileScope" Property="Text" Value="Qualquer aplicativo"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProcessName}" Value="{x:Null}">
                                                        <Setter TargetName="profileScope" Property="Text" Value="Qualquer aplicativo"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter TargetName="profileName" Property="Foreground"
                                                                Value="{DynamicResource TextDimBrush}"/>
                                                        <Setter TargetName="profileOff" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <ScrollViewer x:Name="MenusScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                            <StackPanel Margin="0,0,10,12">

                                <StackPanel x:Name="PnlProfileEditor">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Condições do menu" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Text="Todos os campos são opcionais. Preenchidos, precisam casar para o menu aparecer."
                                                       Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Nome do menu" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="TxtProfileName" MaxLength="60" TextChanged="ProfileField_Changed"
                                                             LostFocus="TxtProfileName_LostFocus"/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkProfileEnabled" Grid.Column="2" Content="Ativo"
                                                          VerticalAlignment="Bottom" Margin="0,0,0,7"
                                                          Checked="ProfileField_Changed" Unchecked="ProfileField_Changed"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Processo (sem .exe)" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtProfileProcess" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                                    <TextBlock Text="Vazio = qualquer aplicativo." Style="{StaticResource FieldHint}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Título contém" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtProfileTitle" MaxLength="120" TextChanged="ProfileField_Changed"/>
                                                    <TextBlock Text="Vazio = qualquer título." Style="{StaticResource FieldHint}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource Divider}"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Prioridade" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="TxtPriorityValue" Grid.Column="1" Style="{StaticResource ValueText}"
                                                           MinWidth="36" Text="0"/>
                                            </Grid>
                                            <TextBlock Text="Maior prioridade é considerada primeiro quando a roda não tem espaço para tudo."
                                                       Style="{StaticResource FieldHint}" Margin="0,0,0,4"/>
                                            <Slider x:Name="SliderProfilePriority" Minimum="-100" Maximum="100" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                                    ValueChanged="ProfileField_Changed" AutomationProperties.Name="Prioridade do menu"/>

                                            <TextBlock Text="Contextos (nenhum marcado = todos)" Style="{StaticResource FieldLabel}"/>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                <UniformGrid x:Name="PnlContexts" Columns="2"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Itens do menu" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="Cada item vira uma fatia da roda. Até 8 itens por menu."
                                                           Style="{StaticResource CardHint}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                                    Padding="7,1" VerticalAlignment="Top" Margin="8,0,0,0">
                                                <TextBlock x:Name="MenuItemCount" Text="0 de 8" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextDimBrush}"
                                                           AutomationProperties.Name="Itens neste menu"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnAddMenuItem" Content="Adicionar" Padding="8,6"
                                                                Click="BtnAddMenuItem_Click" AutomationProperties.Name="Adicionar item ao menu"/>
                                                        <Button x:Name="BtnRemoveMenuItem" Grid.Column="2" Content="Remover" Padding="8,6"
                                                                Click="BtnRemoveMenuItem_Click" AutomationProperties.Name="Remover item selecionado"/>
                                                    </Grid>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnMoveItemUp" Content="Subir" Padding="8,6"
                                                                Click="BtnMoveItemUp_Click" AutomationProperties.Name="Mover item para cima"/>
                                                        <Button x:Name="BtnMoveItemDown" Grid.Column="2" Content="Descer" Padding="8,6"
                                                                Click="BtnMoveItemDown_Click" AutomationProperties.Name="Mover item para baixo"/>
                                                    </Grid>
                                                </StackPanel>

                                                <Grid>
                                                    <ListBox x:Name="ListItems" SelectionChanged="ListItems_SelectionChanged" MinHeight="210"
                                                             Padding="4" FontSize="12">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="itemGlyph" Text="{Binding Glyph}"
                                                                               FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                                                    <TextBlock x:Name="itemLabel" Grid.Column="1" Text="{Binding Label}"
                                                                               ToolTip="{Binding Label}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock x:Name="itemSubmenuBadge" Grid.Column="2"
                                                                               Text="{Binding Options.Count, StringFormat={}{0} opções}"
                                                                               FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                                                                </Grid>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Glyph}" Value="">
                                                                        <Setter TargetName="itemGlyph" Property="Text" Value="&#xE734;"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter TargetName="itemLabel" Property="Foreground"
                                                                                Value="{DynamicResource TextDimBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Submenu">
                                                                        <Setter TargetName="itemSubmenuBadge" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <StackPanel x:Name="PnlNoItems" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                IsHitTestVisible="False" Margin="6">
                                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                                                   Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"
                                                                   Opacity="0.8"/>
                                                        <TextBlock Text="Nenhum item" FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                        <TextBlock Text="Use “Adicionar” para criar o primeiro." Style="{StaticResource CardHint}"
                                                                   FontSize="11" TextAlignment="Center" MaxWidth="120" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DockPanel>

                                            <Grid Grid.Column="2">
                                                <StackPanel x:Name="PnlItemEditor">
                                                    <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionLabel}" Margin="2,0,0,4"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Rótulo" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                        <TextBox x:Name="TxtItemLabel" MaxLength="24" TextChanged="ItemField_Changed"
                                                                 LostFocus="TxtItemLabel_LostFocus"/>
                                                        <TextBlock Text="Ícone" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                                        <ComboBox x:Name="CmbItemGlyph" Width="180" HorizontalAlignment="Left"
                                                                  SelectionChanged="ItemField_Changed">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                                   FontSize="15" Width="22" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Label}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <TextBlock Text="Descrição (opcional)" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="TxtItemDescription" MaxLength="120" TextChanged="ItemField_Changed"/>
                                                    <CheckBox x:Name="ChkItemEnabled" Content="Item ativo" Margin="0,8,0,0"
                                                              Checked="ItemField_Changed" Unchecked="ItemField_Changed"/>

                                                    <Border Style="{StaticResource Divider}" Margin="0,12,0,10"/>

                                                    <TextBlock Text="AÇÃO" Style="{StaticResource SectionLabel}" Margin="2,0,0,4"/>
                                                    <TextBlock Text="Tipo de item" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="CmbItemKind" SelectionChanged="CmbItemKind_SelectionChanged"/>

                                                    <Border x:Name="BdItemTarget" Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="12,2,12,10" Margin="0,10,0,0">
                                                        <Grid>
                                                            <StackPanel x:Name="PnlItemAction">
                                                                <TextBlock Text="Ação do RadialFlow" Style="{StaticResource FieldLabel}"/>
                                                                <ComboBox x:Name="CmbItemAction" SelectionChanged="ItemField_Changed"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemLaunch">
                                                                <TextBlock Text="Executável" Style="{StaticResource FieldLabel}"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="TxtItemLaunch" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                                    <Button Grid.Column="1" Content="Procurar…" Margin="8,0,0,0" Padding="10,6"
                                                                            Click="BtnBrowseExecutable_Click"/>
                                                                </Grid>
                                                                <TextBlock Text="Só executáveis em pastas protegidas (System32, Program Files). Sem argumentos."
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemUrl">
                                                                <TextBlock Text="Endereço (http ou https)" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemUrl" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemPath">
                                                                <TextBlock Text="Arquivo ou pasta" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemPath" MaxLength="2048" TextChanged="ItemField_Changed"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                    <Button Content="Arquivo…" Padding="10,6" Margin="0,0,6,0" Click="BtnBrowseFile_Click"/>
                                                                    <Button Content="Pasta…" Padding="10,6" Click="BtnBrowseFolder_Click"/>
                                                                </StackPanel>
                                                                <TextBlock Text="Executáveis, scripts e atalhos são recusados aqui; para eles use Executável."
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemHotkey">
                                                                <TextBlock Text="Atalho (ex.: Ctrl+Shift+P)" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemHotkey" MaxLength="80" TextChanged="ItemField_Changed"/>
                                                                <TextBlock Text="Modificadores Ctrl/Alt/Shift/Win e uma tecla final. O foco precisa estar na janela de origem."
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>

                                                            <StackPanel x:Name="PnlItemText">
                                                                <TextBlock Text="Texto a colar" Style="{StaticResource FieldLabel}"/>
                                                                <TextBox x:Name="TxtItemText" MaxLength="4096" Height="86" AcceptsReturn="True"
                                                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                                         TextChanged="ItemField_Changed"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel x:Name="PnlItemSubmenu" Visibility="Collapsed">
                                                        <TextBlock Text="OPÇÕES DO SUBMENU" Style="{StaticResource SectionLabel}" Margin="2,12,0,4"/>
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock x:Name="TxtSubmenuCount" Text="0 de 8 opções"
                                                                                   FontSize="12.5" FontWeight="SemiBold"/>
                                                                        <TextBlock x:Name="TxtSubmenuPreview" Text="Nenhuma opção ainda."
                                                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="BtnEditSubmenuOptions" Grid.Column="1" Content="Editar opções…"
                                                                            Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                            Click="BtnEditSubmenuOptions_Click"
                                                                            AutomationProperties.Name="Editar opções do submenu"/>
                                                                </Grid>
                                                                <TextBlock Text="Use entre 2 e 8 opções ativas. Na roda, segure a fatia para abrir o segundo anel."
                                                                           Style="{StaticResource FieldHint}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border x:Name="PnlNoItemSelected" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="10" Padding="20" Visibility="Collapsed">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="240">
                                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                                                   Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"
                                                                   Opacity="0.8"/>
                                                        <TextBlock Text="Nenhum item selecionado" FontSize="13" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                        <TextBlock Text="Selecione um item na lista ou clique em “Adicionar”."
                                                                   Style="{StaticResource CardHint}" FontSize="11.5" TextAlignment="Center"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Prévia da roda" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="PreviewContext" Style="{StaticResource CardHint}"/>

                                        <!-- Empilhado: em janela estreita uma coluna de texto ao lado da roda ficaria ilegível. -->
                                        <Border x:Name="MenuPreviewHost" Width="280" Height="280"
                                                Margin="0,14,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                        <TextBlock x:Name="PreviewSummary" Style="{StaticResource CardHint}"
                                                   Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="PreviewWarning" Style="{StaticResource CardHint}" Margin="0,8,0,0"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>

                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LEGENDA" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                                <WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlBrush}"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="automática" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentSoftBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"/>
                                                        <TextBlock Text="substitui" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                        <Border Width="11" Height="11" CornerRadius="3" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="extra" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                                ToolTip="A fatia abre um segundo anel ao segurar.">
                                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <TextBlock Text="abre submenu" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Style="{StaticResource CardHint}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Text="Fatias em destaque vêm deste menu; as demais são automáticas do contexto. Segure uma fatia com ▾ para abrir o segundo anel. Itens além do limite de 8 ficam de fora da roda."/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="PnlNoProfileSelected" Grid.Column="2" Style="{StaticResource Card}"
                                Padding="24,40" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nenhum menu selecionado" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Crie um menu com “Novo menu” ou selecione um na lista à esquerda. Os itens dele aparecem só nos aplicativos e contextos que você escolher."
                                           Style="{StaticResource CardHint}" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="PnlNoMenus" Grid.Row="1" Margin="32,4,20,20" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Margin="0" Padding="36,34" MaxWidth="560"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Crie seu primeiro menu" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                <TextBlock Text="Dê um nome, escolha em quais aplicativos e contextos ele aparece e adicione os itens da roda."
                                           Style="{StaticResource CardHint}" FontSize="12.5" MaxWidth="420"
                                           TextAlignment="Center" Margin="0,6,0,0"/>
                                <Button x:Name="BtnAddMenuProfile" Content="Criar primeiro menu"
                                        Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="0,20,0,0"
                                        HorizontalAlignment="Center" Click="BtnAddMenuProfile_Click"
                                        AutomationProperties.Name="Criar o primeiro menu personalizado"/>
                                <TextBlock Text="Você pode duplicar, desativar e conferir a prévia antes de salvar."
                                           Style="{StaticResource CardHint}" FontSize="11"
                                           TextAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= CONVERSORES (lista montada em código: SettingsWindow.Converters.cs) ================= -->
            <TabItem Header="Conversores" Tag="&#xE8AB;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="Conversores" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Formatos extras para vídeo, áudio e documentos. Os programas são gratuitos, vêm do site oficial de cada um e são conferidos antes de instalar."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,4,20,20">
                            <TextBlock Text="PROGRAMAS DISPONÍVEIS" Style="{StaticResource SectionLabel}" Margin="3,0,0,7"/>
                            <StackPanel x:Name="ConverterList"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Instalação" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ConverterStatus" Style="{StaticResource CardHint}" Margin="0,3,0,12" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnInstallConverters" Content="Instalar selecionados" Style="{StaticResource PrimaryButton}"
                                                Click="BtnInstallConverters_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="Instalar os conversores selecionados"/>
                                        <Button x:Name="BtnRefreshConverters" Content="Verificar de novo" Click="BtnRefreshConverters_Click"
                                                AutomationProperties.Name="Verificar de novo quais conversores estão instalados"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Fotos WebP, HEIC e AVIF" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,0"
                                               Text="Essas fotos são lidas pelo próprio Windows, com as extensões gratuitas da Microsoft Store: Extensões de Imagem HEIF, Extensões de Imagem da Web e Extensão de Imagem Bruta (o Windows 11 geralmente já tem)."/>
                                    <TextBlock x:Name="WindowsCodecsStatus" Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= SOBRE ================= -->
            <TabItem Header="Sobre" Tag="&#xE946;" Style="{StaticResource SettingsTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="32,24,32,10">
                        <TextBlock Text="Sobre" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Como usar o RadialFlow e informações de diagnóstico."
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,4,20,20">
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="46" Height="46" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                        <Ellipse Width="18" Height="18" Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="3"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutTitle" Text="RadialFlow" FontSize="21" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock x:Name="AboutVersion" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Diagnóstico" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,3,0,10"
                                               Text="Se algo não funcionar, o registro mostra o que aconteceu. Ele não cresce sem limite: os arquivos antigos são apagados sozinhos."/>
                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                                        <TextBlock x:Name="LogPath" FontFamily="Consolas, Cascadia Mono" FontSize="11.5"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnOpenLogs" Content="Abrir pasta de logs" Click="BtnOpenLogs_Click" Margin="0,0,8,0"
                                                AutomationProperties.Name="Abrir a pasta dos logs no Explorer"/>
                                        <Button x:Name="BtnCopyLogPath" Content="Copiar caminho" Click="BtnCopyLogPath_Click"
                                                AutomationProperties.Name="Copiar o caminho do arquivo de log"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Como usar" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Segure e arraste com o botão direito para abrir a roda."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte sobre uma fatia para executá-la."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Fatias com seta ⌄ têm submenu: segure o cursor sobre elas."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Solte no centro do anel para cancelar."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Um clique direito simples, sem arrastar, abre o menu normal do Windows."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Fatias por contexto" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Arquivos e pastas: Comprimir, Converter, Copiar caminho, Mover, Enviar e Renomear."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Barra de título: Maximizar, Snap, Transparência, Sempre no topo, Minimizar e Fechar."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0,0,0,4" Text="•  Campos de texto: Colar, Traduzir, Pesquisar, Formatar e Limpar."/>
                                    <TextBlock Style="{StaticResource CardHint}" Margin="0" Text="•  Área de trabalho: Apps favoritos, Ajustes rápidos, Área de transferência e Bloquear."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= RODAPÉ ================= -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource WarningBrush}"
                             Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="SaveStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"
                               Text="Tudo salvo"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnSave" Content="Salvar" Style="{StaticResource PrimaryButton}" MinWidth="104"
                            Click="BtnSave_Click" Margin="0,0,8,0" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Fechar" MinWidth="92" Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
