<Window x:Class="RadialFlow.UI.RoutineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialFlow.UI.Markup"
        Title="{loc:Loc Routine.WindowTitle}"
        Width="800" Height="640"
        MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor). -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadge}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Routine.Title}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc Routine.Subtitle}"
                               Style="{StaticResource CardHint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Corpo ================= -->
        <Grid Grid.Row="1" Margin="22,18,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de passos -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{loc:Loc Routine.Sequence}" Style="{StaticResource SectionHeader}"
                                        VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                Padding="7,1" Margin="6,0,0,6">
                            <TextBlock x:Name="TxtStepCount" Text="{loc:Loc Menus.RoutineCountZero}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddAction" Content="{loc:Loc Routine.AddAction}" Padding="8,6"
                                    Click="BtnAddAction_Click" AutomationProperties.Name="{loc:Loc Routine.AddAction}"/>
                            <Button x:Name="BtnAddDelay" Grid.Column="2" Content="{loc:Loc Routine.AddDelay}" Padding="8,6"
                                    Click="BtnAddDelay_Click" AutomationProperties.Name="{loc:Loc Routine.AddDelay}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnStepUp" Content="{loc:Loc Common.MoveUp}" Padding="8,6"
                                    Click="BtnStepUp_Click" AutomationProperties.Name="{loc:Loc Routine.MoveUpAutomation}"/>
                            <Button x:Name="BtnStepDown" Grid.Column="2" Content="{loc:Loc Common.MoveDown}" Padding="8,6"
                                    Click="BtnStepDown_Click" AutomationProperties.Name="{loc:Loc Routine.MoveDownAutomation}"/>
                            <Button x:Name="BtnRemoveStep" Grid.Column="4" Content="{loc:Loc Common.Remove}" Padding="8,6"
                                    Click="BtnRemoveStep_Click" AutomationProperties.Name="{loc:Loc Routine.RemoveAutomation}"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Routine.OrderHint}" Style="{StaticResource FieldHint}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="ListSteps" SelectionChanged="ListSteps_SelectionChanged" MinHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" Width="20" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="PnlNoSteps" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Margin="6" Visibility="Collapsed">
                            <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="18"
                                    HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="16"/>
                            </Border>
                            <TextBlock Text="{loc:Loc Routine.EmptyTitle}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{loc:Loc Routine.EmptyHint}" Style="{StaticResource CardHint}"
                                       FontSize="11" TextAlignment="Center" MaxWidth="140" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Editor do passo -->
            <Grid Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <Border x:Name="BdStepEditor" Style="{StaticResource Card}" Margin="0" Padding="18,14">
                        <StackPanel x:Name="PnlStepEditor">
                            <ContentControl Content="{loc:Loc Routine.StepSection}" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="TxtStepKind" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Routine.StepHint}"
                                       Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>

                            <Border x:Name="BdStepValue" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,2,12,10" Margin="0,14,0,0">
                                <Grid>
                                    <StackPanel x:Name="PnlStepAction">
                                        <TextBlock Text="{loc:Loc Routine.NativeAction}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbStepAction" SelectionChanged="StepField_Changed"/>
                                        <TextBlock Text="{loc:Loc Routine.ActionHint}"
                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{loc:Loc Routine.FocusHint}"
                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlStepDelay" Visibility="Collapsed">
                                        <TextBlock Text="{loc:Loc Routine.Delay}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbStepDelay" SelectionChanged="StepField_Changed"/>
                                        <TextBlock Text="{loc:Loc Routine.DelayHint}"
                                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Border x:Name="PnlNoStepSelected" Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="20" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260">
                        <Border Style="{StaticResource IconBadge}" Width="44" Height="44" CornerRadius="22"
                                HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="19"/>
                        </Border>
                        <TextBlock Text="{loc:Loc Routine.NoSelection}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{loc:Loc Routine.NoSelectionHint}"
                                   Style="{StaticResource CardHint}" FontSize="11.5" TextAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Rodapé ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStepsWarning" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:Loc Common.Cancel}" MinWidth="96" IsCancel="True"/>
                    <Button x:Name="BtnDone" Content="{loc:Loc Common.Done}" MinWidth="104" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnDone_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
