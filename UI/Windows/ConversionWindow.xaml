<Window x:Class="RadialFlow.UI.ConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialFlow.UI.Markup"
        Title="{loc:Loc Conversion.WindowTitle}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor).
         O cliente usa o vidro congelado; sem captura, o véu fica opaco (SurfaceBrush). -->
    <Grid x:Name="Root">
        <Border x:Name="GlassImageHost" IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="GlassTint" Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False"/>

        <StackPanel>
            <!-- Cabeçalho -->
            <Border Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileName" Text="{loc:Loc Conversion.SampleFile}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtCategory" Text="{loc:Loc Conversion.SampleCategory}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Opções -->
            <Border Style="{StaticResource Card}" Margin="24,20,24,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Conversion.TargetFormat}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CmbTargetFormat" DisplayMemberPath="DisplayName" SelectedValuePath="TargetFormat" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtBatchNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="{loc:Loc Conversion.SaveToFolder}" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDestinationDir"/>
                        <Button Grid.Column="1" Content="{loc:Loc Common.Browse}" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ações -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,18,24,22">
                <Button x:Name="BtnConvert" Content="{loc:Loc Conversion.Button}" Style="{StaticResource PrimaryButton}" MinWidth="110" IsDefault="True"
                        Click="BtnConvert_Click" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc Common.Cancel}" MinWidth="96" IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
