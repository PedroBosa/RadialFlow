<Project>

  <!-- Metadados de projeto e autoria -->
  <PropertyGroup>
    <Authors>Pedro Bosa</Authors>
    <Company>Pedro Bosa</Company>
    <Copyright>Copyright (c) 2026 Pedro Bosa</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PedroBosa/RadialFlow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PedroBosa/RadialFlow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Configurações comuns ao aplicativo e aos testes. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Desligado de propósito: System.IO.Path conflitaria com System.Windows.Shapes.Path. Todos os imports são explícitos. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Qualidade: nenhum aviso passa despercebido. Um aviso novo quebra o build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Builds reproduzíveis. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
