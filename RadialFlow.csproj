<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RadialFlow</RootNamespace>
    <!-- Ícone do executável (gerado por tools/IconGenerator a partir do mesmo código que desenha a bandeja). -->
    <ApplicationIcon>Assets\RadialFlow.ico</ApplicationIcon>
    <!-- Projetos irmãos que moram dentro desta pasta: sem isso, os .cs deles entrariam no app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);RadialFlow.Tests\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Identidade do produto (aparece nas propriedades do .exe, no log e na janela "Sobre"). -->
  <PropertyGroup>
    <Version>1.2.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Product>RadialFlow</Product>
    <AssemblyTitle>RadialFlow</AssemblyTitle>
    <Description>Menu radial para o Windows</Description>
    <Authors>Pedro Lucas Ferreira Bosa</Authors>
    <Company>Pedro Lucas Ferreira Bosa</Company>
    <Copyright>Copyright © 2026 Pedro Lucas Ferreira Bosa</Copyright>
    <!-- Sem o hash do commit no número da versão exibido. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Qualidade: análise recomendada. A política de exceções (com motivo) está no .editorconfig. -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regras puras (ActionRouter.Logic, ToolLocator, validações) são internal e testadas diretamente. -->
    <InternalsVisibleTo Include="RadialFlow.Tests" />
  </ItemGroup>

</Project>
