<Window x:Class="RadialFlow.UI.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadialFlow Overlay"
        Width="440" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual">

    <!-- Fundo #01000000 (opacidade 1/255, invisível): numa janela com transparência por pixel, o Windows deixa o mouse
         atravessar os pixels 100% transparentes. Com este fundo, o quadrado inteiro da roda "segura" o mouse e o
         programa de baixo não mostra dicas nem destaques enquanto a roda está aberta. -->

    <Grid x:Name="Root" Width="440" Height="440"
          RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.75" ScaleY="0.75"/>
        </Grid.RenderTransform>

        <!-- Halo estático de sombra ao redor do anel (fora dele: não escurece o vidro). Barato: não recalcula a cada quadro. -->
        <Ellipse Width="440" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop Color="#00000000" Offset="0.765"/>
                    <GradientStop Color="#40000000" Offset="0.80"/>
                    <GradientStop Color="#16000000" Offset="0.90"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Fatias do anel: criadas em código (RadialMenuWindow.Visuals.cs) -->
        <Canvas x:Name="WheelCanvas" Width="440" Height="440" RenderTransformOrigin="0.5,0.5"/>

        <!-- Miolo: marca em repouso; ícone da fatia sob o cursor; seta "voltar" nos submenus -->
        <Grid x:Name="CenterHub" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="HubBg" Width="80" Height="80" StrokeThickness="1.2">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="IdleDot" Width="24" Height="24" StrokeThickness="3.2"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock x:Name="HubGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="HubGlyphScale" ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- Traço de espera do "voltar": contorna o miolo dentro de um submenu, no mesmo estilo do traço das fatias.
             Geometria, cor e animação em RadialMenuWindow.Visuals.cs. -->
        <Path x:Name="BackDwellArc" Width="440" Height="440" HorizontalAlignment="Left" VerticalAlignment="Top"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect x:Name="BackDwellGlow" BlurRadius="10" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- Dica abaixo do anel -->
        <Border x:Name="HintPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,411,0,0"
                CornerRadius="11" Padding="12,3,12,4" Opacity="0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="HintText" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11.5"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
        </Border>
    </Grid>
</Window>
