<Window x:Class="RadialFlow.UI.SubmenuEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RadialFlow.UI.Markup"
        Title="{loc:Loc Submenu.WindowTitle}"
        Width="820" Height="660"
        MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <!-- Estilos e cores: Theme/Controls.xaml + UiTheme (instalados no construtor). -->
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource CardHint}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Cabeçalho ================= -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconBadge}" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A9;"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Submenu.Title}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc Submenu.Subtitle}"
                               Style="{StaticResource CardHint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Corpo ================= -->
        <Grid Grid.Row="1" Margin="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de opções -->
            <Border Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Content="{loc:Loc Submenu.OptionsTitle}" Style="{StaticResource SectionHeader}"
                                        VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" CornerRadius="8"
                                Padding="7,1" Margin="6,0,0,6">
                            <TextBlock x:Name="TxtOptionCount" Text="{loc:Loc Menus.SubmenuCountZero}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDimBrush}"/>
                        </Border>
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddOption" Content="{loc:Loc Common.Add}" Padding="8,6"
                                    Click="BtnAddOption_Click" AutomationProperties.Name="{loc:Loc Submenu.AddAutomation}"/>
                            <Button x:Name="BtnRemoveOption" Grid.Column="2" Content="{loc:Loc Common.Remove}" Padding="8,6"
                                    Click="BtnRemoveOption_Click" AutomationProperties.Name="{loc:Loc Submenu.RemoveAutomation}"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOptionUp" Content="{loc:Loc Common.MoveUp}" Padding="8,6"
                                    Click="BtnOptionUp_Click" AutomationProperties.Name="{loc:Loc Submenu.MoveUpAutomation}"/>
                            <Button x:Name="BtnOptionDown" Grid.Column="2" Content="{loc:Loc Common.MoveDown}" Padding="8,6"
                                    Click="BtnOptionDown_Click" AutomationProperties.Name="{loc:Loc Submenu.MoveDownAutomation}"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Submenu.OrderHint}" Style="{StaticResource FieldHint}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid>
                        <ListBox x:Name="ListOptions" SelectionChanged="ListOptions_SelectionChanged" MinHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="optionGlyph" Text="{Binding Glyph}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="14" Width="20"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                        <TextBlock x:Name="optionLabel" Grid.Column="1" Text="{Binding Label}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Glyph}" Value="">
                                            <Setter TargetName="optionGlyph" Property="Text" Value="&#xE734;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter TargetName="optionLabel" Property="Foreground"
                                                    Value="{DynamicResource TextDimBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="PnlNoOptions" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Margin="6" Visibility="Collapsed">
                            <Border Style="{StaticResource IconBadge}" Width="36" Height="36" CornerRadius="18"
                                    HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="16"/>
                            </Border>
                            <TextBlock Text="{loc:Loc Submenu.EmptyTitle}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="{loc:Loc Submenu.EmptyHint}" Style="{StaticResource CardHint}"
                                       FontSize="11" TextAlignment="Center" MaxWidth="130" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Editor da opção -->
            <Grid Grid.Column="2">
                <ScrollViewer x:Name="OptionScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <Border x:Name="BdOptionEditor" Style="{StaticResource Card}" Margin="0" Padding="18,14">
                        <StackPanel x:Name="PnlOptionEditor">
                            <ContentControl Content="{loc:Loc Menus.AppearanceSection}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Common.Label}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtOptionLabel" MaxLength="24" TextChanged="OptionField_Changed"
                                             LostFocus="TxtOptionLabel_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{loc:Loc Common.Icon}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbOptionGlyph" Width="140" SelectionChanged="OptionVisual_Changed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="15" Width="22" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{loc:Loc Common.DescriptionOptional}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtOptionDescription" MaxLength="120" TextChanged="OptionField_Changed"/>
                            <CheckBox x:Name="ChkOptionEnabled" Content="{loc:Loc Submenu.Active}" Margin="0,8,0,0"
                                      Checked="OptionVisual_Changed" Unchecked="OptionVisual_Changed"/>

                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,10"/>

                            <ContentControl Content="{loc:Loc Menus.ActionSection}" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{loc:Loc Submenu.KindLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbOptionKind" SelectionChanged="CmbOptionKind_SelectionChanged"/>

                            <Border x:Name="BdOptionTarget" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,2,12,10" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel x:Name="PnlOptionAction">
                                        <TextBlock Text="{loc:Loc Choices.Kind.Action}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbOptionAction" SelectionChanged="OptionField_Changed"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlOptionLaunch">
                                        <TextBlock Text="{loc:Loc Menus.Executable}" Style="{StaticResource FieldLabel}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtOptionLaunch" MaxLength="2048" TextChanged="OptionField_Changed"/>
                                            <Button Grid.Column="1" Content="{loc:Loc Common.Browse}" Margin="8,0,0,0" Padding="10,6"
                                                    Click="BtnBrowseOptionExecutable_Click"/>
                                        </Grid>
                                        <TextBlock Text="{loc:Loc Menus.ExecutableHint}"
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlOptionUrl">
                                        <TextBlock Text="{loc:Loc Menus.UrlLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtOptionUrl" MaxLength="2048" TextChanged="OptionField_Changed"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlOptionPath">
                                        <TextBlock Text="{loc:Loc Menus.PathLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtOptionPath" MaxLength="2048" TextChanged="OptionField_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="{loc:Loc Menus.FileButton}" Padding="10,6" Margin="0,0,6,0"
                                                    Click="BtnBrowseOptionFile_Click"/>
                                            <Button Content="{loc:Loc Menus.FolderButton}" Padding="10,6" Click="BtnBrowseOptionFolder_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc Menus.PathHint}"
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlOptionHotkey">
                                        <TextBlock Text="{loc:Loc Menus.HotkeyLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtOptionHotkey" MaxLength="80" TextChanged="OptionField_Changed"/>
                                        <TextBlock Text="{loc:Loc Submenu.HotkeyHint}"
                                                   Style="{StaticResource FieldHint}"/>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlOptionText">
                                        <TextBlock Text="{loc:Loc Menus.TextLabel}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtOptionText" MaxLength="4096" Height="76" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 TextChanged="OptionField_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <Border x:Name="PnlNoOptionSelected" Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="20" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260">
                        <Border Style="{StaticResource IconBadge}" Width="44" Height="44" CornerRadius="22"
                                HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A9;" FontSize="19"/>
                        </Border>
                        <TextBlock Text="{loc:Loc Submenu.NoSelection}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="{loc:Loc Submenu.NoSelectionHint}"
                                   Style="{StaticResource CardHint}" FontSize="11.5" TextAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Rodapé ================= -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtOptionsWarning" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,16,0"
                           Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnDone" Content="{loc:Loc Common.Done}" MinWidth="104" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" Click="BtnDone_Click"/>
                    <Button Content="{loc:Loc Common.Cancel}" MinWidth="96" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
